generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
}

// -------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------

enum Role {
  ADMIN
  STUDENT
  APPLICANT
  JUROR
  USER
}

enum MessageRole {
  USER
  ASSISTANT
  SYSTEM
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DocumentStatus {
  PROCESSING   // Subiéndose / procesando embeddings
  INDEXED      // Activo para búsqueda en RAG
  DEINDEXED    // Desindexado temporalmente (no se consulta en RAG)
  ERROR        // Fallo al procesar
}

enum ModelProvider {
  LOCAL_MAC    // Mac Mini M4 vía Cloudflare Tunnel
  OPENAI
  GEMINI  
  ANTHROPIC
  GROQ
}

enum ModelStatus {
  ONLINE      // Activo y respondiendo con baja latencia
  DEGRADED    // Problemas de ping / latencia alta
  OFFLINE     // Sin respuesta / caído
  DISABLED    // Desactivado manualmente por el administrador
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

enum ResolutionStatus {
  RESOLVED_WITH_SOURCES   // Éxito: RAG encontró contexto oficial (> umbral) y generó citas
  RESOLVED_GENERAL        // Éxito: Pregunta general/saludo respondido sin necesidad de RAG
  NO_CONTEXT_FOUND        // Gap: No hay documentos en la base de datos sobre esta consulta
  UNRESOLVED_BY_FALLBACK  // El modelo activó la frase de contingencia/desconocimiento
  POSITIVE_FEEDBACK       // El usuario evaluó positivamente la respuesta (Like / 4-5 estrellas)
  NEGATIVE_FEEDBACK       // El usuario evaluó negativamente la respuesta (Dislike / 1-2 estrellas)
  ERROR_OCCURRED          // Fallo técnico en el modelo o en la base de datos
}

enum TokenUsageConcept {
  CHAT_COMPLETION            // Respuesta conversacional del asistente
  RAG_EMBEDDING              // Generación de vector embeddings para fragmentos
  DOCUMENT_OCR_TRANSCRIPTION // Transcripción de PDF/documento a Markdown con Gemini OCR
  QUERY_ANALYSIS             // Clasificación semántica de intención / categorías
  OTHER
}

// -------------------------------------------------------------
// AUTENTICACIÓN & USUARIOS
// -------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  email         String    @unique
  emailVerified DateTime? @map("email_verified")
  password      String?   // Hash bcrypt/argon2 para Credentials
  image         String?
  role          Role      @default(USER)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relaciones Auth
  accounts      Account[]
  sessions      Session[]
  Authenticator Authenticator[]

  // Relaciones del Sistema
  memories        UserMemory[]
  posts           Post[]
  conversations   Conversation[]
  feedbacks       Feedback[]
  requestLogs     RequestLog[]
  preguntas       Pregunta[]
  uploadedDocs    Document[]        @relation("AdminUploadedDocs")
  sentInvitations AdminInvitation[] @relation("SentAdminInvitations")
  usage           UserUsage?
  tokenUsageLogs  TokenUsageLog[]

  @@map("users")
}

model AdminInvitation {
  id          String           @id @default(cuid())
  email       String           @unique
  token       String           @unique
  role        Role             @default(ADMIN)
  status      InvitationStatus @default(PENDING)
  invitedById String?          @map("invited_by_id")
  expiresAt   DateTime         @map("expires_at")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")

  invitedBy   User?            @relation("SentAdminInvitations", fields: [invitedById], references: [id], onDelete: SetNull)

  @@map("admin_invitations")
}

model Account {
  userId            String   @map("user_id")
  type              String
  provider          String
  providerAccountId String   @map("provider_account_id")
  refresh_token     String?  @db.Text
  access_token      String?  @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?  @db.Text
  session_state     String?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  userAgent    String?  @map("user_agent")
  ipAddress    String?  @map("ip_address")
  deviceType   String?  @map("device_type") // "desktop", "mobile", "tablet"
  browserName  String?  @map("browser_name") // "Chrome", "Firefox", "Safari", etc.
  osName       String?  @map("os_name") // "Windows", "macOS", "Android", etc.
  location     String?  // Ciudad / País real
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Authenticator {
  credentialID         String  @unique @map("credential_id")
  userId               String  @map("user_id")
  providerAccountId    String  @map("provider_account_id")
  credentialPublicKey  String  @map("credential_public_key")
  counter              Int
  credentialDeviceType String  @map("credential_device_type")
  credentialBackedUp   Boolean @map("credential_backed_up")
  transports           String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
  @@map("authenticators")
}

// -------------------------------------------------------------
// CATÁLOGO DE TEMAS PARA ANALÍTICA UNIVERSITARIA
// -------------------------------------------------------------

model TopicCategory {
  id          String         @id @default(cuid())
  name        String         @unique // Ej: "Matrícula y Registro", "Pensiones y Pagos", "Convalidaciones"
  code        String         @unique // Ej: "MATRICULA", "PAGOS", "CONVALIDACIONES"
  description String?        @db.Text
  order       Int            @default(0)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  subcategories TopicSubcategory[]
  messages      Message[]
  documents     Document[]
  preguntas     Pregunta[]

  @@map("topic_categories")
}

model TopicSubcategory {
  id          String        @id @default(cuid())
  categoryId  String        @map("category_id")
  name        String        // Ej: "Matrícula Extemporánea", "Fraccionamiento", "Traslado Externo"
  code        String        // Ej: "MAT_EXTEMPORANEA", "PAG_FRACCIONAMIENTO"
  description String?
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  category    TopicCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  messages    Message[]
  preguntas   Pregunta[]

  @@unique([categoryId, code])
  @@map("topic_subcategories")
}

// -------------------------------------------------------------
// CHATBOT, MENSAJES Y CITAS RAG
// -------------------------------------------------------------

model Conversation {
  id        String    @id @default(cuid())
  title     String    @default("Nueva Consulta")
  userId    String?   @map("user_id")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  user           User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages       Message[]
  tokenUsageLogs TokenUsageLog[]

  @@map("conversations")
}

model Message {
  id             String           @id @default(cuid())
  conversationId String           @map("conversation_id")
  role           MessageRole
  content        String           @db.Text
  
  // Analítica de la Pregunta
  categoryId       String?          @map("category_id")
  subcategoryId    String?          @map("subcategory_id")
  detectedIntent   String?          @map("detected_intent") // Ej: "CONSULTA_FECHAS_PAGO"
  resolutionStatus ResolutionStatus @default(RESOLVED_WITH_SOURCES) @map("resolution_status")

  // Trazabilidad Técnica & Métricas
  modelUsed           String?          @map("model_used")
  embeddingModel      String?          @default("gemini-embedding-2") @map("embedding_model")
  promptTokens        Int?             @map("prompt_tokens")
  totalTokens         Int?             @map("total_tokens")
  latencyMs           Int?             @map("latency_ms")
  retrievalLatencyMs  Int?             @map("retrieval_latency_ms")
  generationLatencyMs Int?             @map("generation_latency_ms")
  isVoiceInput        Boolean          @default(false) @map("is_voice_input")
  isRegeneration      Boolean          @default(false) @map("is_regeneration")
  regeneratedFromId   String?          @map("regenerated_from_id")
  parentId            String?          @map("parent_id")

  createdAt DateTime @default(now()) @map("created_at")

  conversation   Conversation      @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  category       TopicCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategory    TopicSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  parent         Message?          @relation("MessageTree", fields: [parentId], references: [id], onDelete: Cascade)
  children       Message[]         @relation("MessageTree")
  feedbacks      Feedback[]
  citations      MessageCitation[]

  @@map("messages")
}

model MessageCitation {
  id             String   @id @default(cuid())
  messageId      String   @map("message_id")
  documentId     String?  @map("document_id")
  chunkId        String?  @map("chunk_id")
  title          String   // Nombre del reglamento/documento citado
  sourceUrl      String?  @map("source_url")   // URL pública al PDF institucional
  pageNumber     Int?     @map("page_number")  // Número de página (permite enlace url#page=X)
  snippetText    String   @map("snippet_text") @db.Text // Fragmento exacto recuperado
  relevance      Float?   // Score de similitud (0.0 - 1.0)
  embeddingModel String?  @default("gemini-embedding-2") @map("embedding_model")
  createdAt      DateTime @default(now()) @map("created_at")

  message  Message        @relation(fields: [messageId], references: [id], onDelete: Cascade)
  document Document?      @relation(fields: [documentId], references: [id], onDelete: SetNull)
  chunk    DocumentChunk? @relation(fields: [chunkId], references: [id], onDelete: SetNull)

  @@map("message_citations")
}

// -------------------------------------------------------------
// BASE DE CONOCIMIENTO (DOCUMENTOS & CHUNKS)
// -------------------------------------------------------------

model Document {
  id           String         @id @default(cuid())
  title        String
  fileName     String         @map("file_name")
  fileUrl      String?        @map("file_url")    // URL en storage local / S3
  publicUrl    String?        @map("public_url")  // Enlace público oficial institucional
  mimeType     String         @map("mime_type")
  sizeBytes    Int            @map("size_bytes")
  status       DocumentStatus @default(PROCESSING)
  chunkCount   Int            @default(0) @map("chunk_count")
  categoryId   String?        @map("category_id") // Categoría temática general del PDF
  uploadedById String?        @map("uploaded_by_id")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  category   TopicCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  uploadedBy User?             @relation("AdminUploadedDocs", fields: [uploadedById], references: [id], onDelete: SetNull)
  chunks     DocumentChunk[]
  citations  MessageCitation[]

  @@map("documents")
}

model DocumentChunk {
  id          String   @id @default(cuid())
  documentId  String   @map("document_id")
  chunkIndex  Int      @map("chunk_index")
  content     String   @db.Text
  pageNumber  Int?     @map("page_number")
  metadata    Json?    // Metadatos (título del capítulo, sección)
  createdAt   DateTime @default(now()) @map("created_at")

  document  Document          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  citations MessageCitation[]

  @@map("document_chunks")
}

// -------------------------------------------------------------
// MEMORIA A LARGO PLAZO DEL USUARIO
// -------------------------------------------------------------

model UserMemory {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  fact      String   @db.Text // Ej: "Estudia Ingeniería de Sistemas en Sede Chiclayo"
  category  String?  // Ej: "academico", "preferencia"
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_memories")
}

// -------------------------------------------------------------
// CONFIGURACIÓN DINÁMICA DE MODELOS Y LÍMITES
// -------------------------------------------------------------

model AIModelConfig {
  id                    String        @id @default(cuid())
  name                  String        @unique // Ej: "Gemini 3.1 Flash Lite", "GPT-4o Mini"
  modelCode             String        @map("model_code")
  provider              ModelProvider @default(LOCAL_MAC)
  description           String?       @db.Text
  endpointUrl           String?       @map("endpoint_url")
  apiKeyEnvVar          String?       @map("api_key_env_var")
  status                ModelStatus   @default(ONLINE)
  latencyMs             Int?          @map("latency_ms")
  isActive              Boolean       @default(true) @map("is_active")
  isDefault             Boolean       @default(false) @map("is_default")
  order                 Int           @default(0)
  maxTokens             Int           @default(2048) @map("max_tokens")
  temperature           Float         @default(0.3)

  // Precios y Métricas de Uso Referenciales
  inputPricePerMillion  Float         @default(0.0) @map("input_price_per_million")  // Costo en USD por 1M tokens de entrada
  outputPricePerMillion Float         @default(0.0) @map("output_price_per_million") // Costo en USD por 1M tokens de salida
  totalInferences       Int           @default(0) @map("total_inferences")           // Total de invocaciones / vistas
  totalTokensUsed       Int           @default(0) @map("total_tokens_used")          // Total de tokens consumidos
  estimatedCostUsd      Float         @default(0.0) @map("estimated_cost_usd")       // Costo total estimado acumulado (USD)

  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  @@map("ai_model_configs")
}

model TokenUsageLog {
  id               String            @id @default(cuid())
  userId           String?           @map("user_id")
  conversationId   String?           @map("conversation_id")
  messageId        String?           @map("message_id")
  modelCode        String            @map("model_code")
  provider         ModelProvider     @default(GEMINI)
  concept          TokenUsageConcept @default(CHAT_COMPLETION)
  promptTokens     Int               @default(0) @map("prompt_tokens")
  completionTokens Int               @default(0) @map("completion_tokens")
  totalTokens      Int               @default(0) @map("total_tokens")
  estimatedCostUsd Float             @default(0.0) @map("estimated_cost_usd")
  latencyMs        Int?              @map("latency_ms")
  metadata         Json?
  createdAt        DateTime          @default(now()) @map("created_at")

  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([concept])
  @@index([modelCode])
  @@index([createdAt])
  @@map("token_usage_logs")
}

model SystemSetting {
  id                    String   @id @default("global_config")
  maxPromptChars        Int      @default(2000) @map("max_prompt_chars")
  maxDailyTokensPerUser Int      @default(50000) @map("max_daily_tokens_per_user")
  enableVoiceInput      Boolean  @default(true) @map("enable_voice_input")
  enableRAG             Boolean  @default(true) @map("enable_rag")
  enableWebSearch       Boolean  @default(false) @map("enable_web_search")
  enableMapsSearch      Boolean  @default(false) @map("enable_maps_search")
  enableImageAnalysis   Boolean  @default(true) @map("enable_image_analysis")
  minSimilarityScore    Float    @default(0.50) @map("min_similarity_score")
  maintenanceMode       Boolean  @default(false) @map("maintenance_mode")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}

model UserUsage {
  id            String    @id @default(cuid())
  userId        String    @unique @map("user_id")
  dailyTokens   Int       @default(0) @map("daily_tokens")
  totalTokens   Int       @default(0) @map("total_tokens")
  lastRequestAt DateTime? @map("last_request_at")
  resetAt       DateTime  @default(now()) @map("reset_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_usages")
}

// -------------------------------------------------------------
// FEEDBACK (1 A 5 ESTRELLAS) Y AUDITORÍA
// -------------------------------------------------------------

model Feedback {
  id        String   @id @default(cuid())
  messageId String?  @map("message_id")
  userId    String?  @map("user_id")
  rating    Int      // Calificación numérica: 1 a 5 estrellas
  comment   String?  @db.Text // Comentario opcional del estudiante/evaluador
  reasons   String[] @default([]) // Etiquetas: ["INEXACTO", "DESACTUALIZADO", "LENTO", "MUY_UTIL"]
  createdAt DateTime @default(now()) @map("created_at")

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  message Message? @relation(fields: [messageId], references: [id], onDelete: SetNull)

  @@map("feedbacks")
}

model RequestLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  endpoint   String?
  method     String?
  statusCode Int      @map("status_code")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  durationMs Int?     @map("duration_ms")
  timestamp  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("request_logs")
}

// -------------------------------------------------------------
// CONTENIDO EDITORIAL & PREGUNTAS FRECUENTES
// -------------------------------------------------------------

model Post {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?    @db.Text
  content     String     @db.Text
  coverImage  String?    @map("cover_image")
  externalUrl String?    @map("external_url")
  status      PostStatus @default(DRAFT)
  authorId    String     @map("author_id")
  categoryId  String?    @map("category_id")
  publishedAt DateTime?  @map("published_at")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  author   User      @relation(fields: [authorId], references: [id])
  category Category? @relation(fields: [categoryId], references: [id])

  @@map("posts")
}

model Category {
  id          String   @id @default(cuid())
  name        String   @unique
  slug        String   @unique
  description String?
  posts       Post[]

  @@map("categories")
}

model Pregunta {
  id            String   @id @default(cuid())
  text          String   @map("contenido") @db.Text
  icon          String   @default("📋")
  category      String?  @default("general") // Fallback / nombre legible
  categoryId    String?  @map("category_id")
  subcategoryId String?  @map("subcategory_id")
  order         Int      @default(0)
  isActive      Boolean  @default(true) @map("is_active")
  createdById   String?  @map("creado_por_id")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  categoryRel    TopicCategory?    @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  subcategoryRel TopicSubcategory? @relation(fields: [subcategoryId], references: [id], onDelete: SetNull)
  creadoPor      User?             @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@map("preguntas")
}